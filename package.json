{
	"name": "JaShipping",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"varlock": "1.18.0",
			"@trpc/server": "^11.18.0",
			"better-auth": "1.7.5",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"tailwindcss": "^4.3.3",
			"@trpc/client": "^11.18.0",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"drizzle-orm": "1.0.0-rc.4"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"check-types": "bun run --filter '*' check-types",
		"dev:web": "bun run --filter web dev",
		"dev:server": "bun run --filter server dev",
		"db:push": "bun run --filter @JaShipping/db db:push",
		"db:studio": "bun run --filter @JaShipping/db db:studio",
		"db:generate": "bun run --filter @JaShipping/db db:generate",
		"db:migrate": "bun run --filter @JaShipping/db db:migrate",
		"db:start": "docker compose up -d postgres",
		"db:watch": "docker compose up postgres",
		"db:stop": "docker compose stop postgres",
		"db:down": "docker compose down postgres",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate",
		"check": "biome check --write .",
		"pilot:phase4": "bun run --filter server pilot:phase4"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@JaShipping/config": "workspace:*",
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "catalog:",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.2"
}
